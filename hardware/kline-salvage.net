(export (version "E")
  (design
    (source "kline-salvage")
    (date "2026-09-07")
    (tool "e36obd")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block
        (title "ESP32 sobre front-end de linea K reciclado del ELM327 BT")
        (company "e36obd")
        (comment (number "1") (value "El front-end del dongle esta VERIFICADO: dio BUS INIT ERROR, o sea que manejo la linea K"))
        (comment (number "2") (value "TRES INCOGNITAS a medir en la placa: VLOGIC, pines TX/RX del PIC, e inversion"))
        (comment (number "3") (value "El PIC hay que SACARLO o aislarlo: si no, pelea el TX con el ESP32"))
        (comment (number "4") (value "R1/R2 solo si VLOGIC = 5 V. Si es 3,3 V se conectan directo")))))

  (components
    (comp (ref "MOD1")
      (value "ELM327-BT-SALVAGE")
      (footprint "Salvage:ELM327_Board")
      (fields
        (field (name "Nota") "Placa del dongle: ficha OBD2 + front-end linea K + regulador")
        (field (name "Sacar") "PIC18F25K80 y modulo Bluetooth"))
      (libsource (lib "Salvage") (part "ELM327_Board") (description "Front-end reciclado")))
    (comp (ref "U2")
      (value "ESP32-S3-DevKitC-1")
      (footprint "Module:ESP32-S3-DevKitC-1")
      (fields (field (name "Nota") "3,3 V. GPIO17 TX, GPIO18 RX, GPIO4 ADC"))
      (libsource (lib "RF_Module") (part "ESP32-S3") (description "MCU")))
    (comp (ref "R1")
      (value "10k")
      (footprint "Resistor_SMD:R_0805_2012Metric")
      (fields (field (name "Nota") "Divisor de RX, rama alta. SOLO si VLOGIC = 5 V"))
      (libsource (lib "Device") (part "R") (description "Divisor RX")))
    (comp (ref "R2")
      (value "15k")
      (footprint "Resistor_SMD:R_0805_2012Metric")
      (fields (field (name "Nota") "5 V x 15/25 = 3,0 V. Sobre el umbral VIH del ESP32"))
      (libsource (lib "Device") (part "R") (description "Divisor RX")))
    (comp (ref "R3")
      (value "100k")
      (footprint "Resistor_SMD:R_0805_2012Metric")
      (fields (field (name "Nota") "Sensado de tension, rama alta"))
      (libsource (lib "Device") (part "R") (description "Divisor de sensado")))
    (comp (ref "R4")
      (value "22k")
      (footprint "Resistor_SMD:R_0805_2012Metric")
      (fields (field (name "Nota") "16 V -> 2,88 V en ADC1"))
      (libsource (lib "Device") (part "R") (description "Divisor de sensado")))
    (comp (ref "D1")
      (value "BAT54")
      (footprint "Diode_SMD:D_SOD-323")
      (fields (field (name "Nota") "Clamp a 3V3 en la entrada RX, por transitorios"))
      (libsource (lib "Device") (part "D_Schottky") (description "Clamp"))))

  (nets
    (net (code "1") (name "GND")
      (node (ref "MOD1") (pin "GND"))
      (node (ref "U2") (pin "GND"))
      (node (ref "R2") (pin "2"))
      (node (ref "R4") (pin "2")))

    (net (code "2") (name "VBAT_12V")
      (node (ref "MOD1") (pin "OBD16"))
      (node (ref "R3") (pin "1")))

    (net (code "3") (name "K_TX")
      (node (ref "MOD1") (pin "TXIN"))
      (node (ref "U2") (pin "GPIO17")))

    (net (code "4") (name "K_RX_RAW")
      (node (ref "MOD1") (pin "RXOUT"))
      (node (ref "R1") (pin "1")))

    (net (code "5") (name "K_RX")
      (node (ref "R1") (pin "2"))
      (node (ref "R2") (pin "1"))
      (node (ref "D1") (pin "1"))
      (node (ref "U2") (pin "GPIO18")))

    (net (code "6") (name "+3V3")
      (node (ref "U2") (pin "3V3"))
      (node (ref "D1") (pin "2")))

    (net (code "7") (name "+5V")
      (node (ref "MOD1") (pin "VREG5"))
      (node (ref "U2") (pin "5V")))

    (net (code "8") (name "V_SENSE")
      (node (ref "R3") (pin "2"))
      (node (ref "R4") (pin "1"))
      (node (ref "U2") (pin "GPIO4")))))
