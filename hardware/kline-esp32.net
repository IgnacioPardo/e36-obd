(export (version "E")
  (design
    (source "kline-frontend")
    (date "2026-08-28")
    (tool "e36obd")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block
        (title "Front-end K-Line E36 - KWP71")
        (company "e36obd")
        (comment (number "1") (value "J2: 1 GND, 2 +5V, 3 K_RX, 4 +3V3, 5 K_TX, 6 V_SENSE, 7 GND"))
        (comment (number "2") (value "Pinout L9637D: ST Doc ID 1765 Rev 8, tabla 2"))
        (comment (number "3") (value "VCC 3..7 V -> alimentado a 3,3 V desde el MCU, sin conversor"))
        (comment (number "4") (value "K va a OBD2 pin 7 Y pin 15: el DME despierta por la linea L"))
        (comment (number "5") (value "R1 510R exigido por hoja de datos: RKO <= 5 kOhm")))))

  (components
    (comp (ref "J1")
      (value "OBD2-M")
      (footprint "Connector:OBD2_Male")
      (fields (field (name "Nota") "Reciclada del ELM327. Solo 4,5,7,15,16 conectados"))
      (libsource (lib "Connector") (part "Conn_01x16") (description "Ficha OBD2 macho")))
    (comp (ref "J2")
      (value "MCU-7")
      (footprint "Connector_JST:JST_XH_B7B-XH-A_1x07_P2.50mm_Vertical")
      (fields (field (name "Nota") "Al ESP32 por cable. Con traba, no dupont suelto"))
      (libsource (lib "Connector") (part "Conn_01x07") (description "Salida al MCU")))
    (comp (ref "J3")
      (value "BUCK-4")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical")
      (fields (field (name "Nota") "Modulo buck comprado, >=1 A. VIN GND VOUT GND"))
      (libsource (lib "Connector") (part "Conn_01x04") (description "Zocalo del buck")))
    (comp (ref "U1")
      (value "L9637D")
      (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm")
      (fields (field (name "Nota") "VS 4,5-36 V, transitorios 40 V, inversion -24 V"))
      (libsource (lib "Interface") (part "L9637D") (description "Bus driver ISO 9141")))
    (comp (ref "F1")
      (value "1A")
      (footprint "Fuse:Fuse_1206_3216Metric_Pad1.42x1.75mm_HandSolder")
      (libsource (lib "Device") (part "Fuse") (description "Fusible de entrada")))
    (comp (ref "D1")
      (value "SMBJ26A")
      (footprint "Diode_SMD:D_SMB")
      (fields (field (name "Nota") "TVS unidireccional, standoff 26 V"))
      (libsource (lib "Device") (part "D_TVS") (description "Supresor de transitorios")))
    (comp (ref "R1")
      (value "510R")
      (footprint "Resistor_SMD:R_0805_2012Metric")
      (fields (field (name "Nota") "Pull-up de K a VS. Obligatorio, <= 5 kOhm"))
      (libsource (lib "Device") (part "R") (description "Pull-up linea K")))
    (comp (ref "R2")
      (value "100k")
      (footprint "Resistor_SMD:R_0805_2012Metric")
      (libsource (lib "Device") (part "R") (description "Divisor de sensado, rama alta")))
    (comp (ref "R3")
      (value "22k")
      (footprint "Resistor_SMD:R_0805_2012Metric")
      (fields (field (name "Nota") "16 V de entrada -> 2,88 V en el ADC"))
      (libsource (lib "Device") (part "R") (description "Divisor de sensado, rama baja")))
    (comp (ref "C1")
      (value "100n")
      (footprint "Capacitor_SMD:C_0805_2012Metric")
      (fields (field (name "Nota") "Desacople de VCC, a menos de 5 mm de U1 pin 3"))
      (libsource (lib "Device") (part "C") (description "Desacople")))
    (comp (ref "C2")
      (value "470u/50V")
      (footprint "Capacitor_THT:CP_Radial_D10.0mm_P5.00mm")
      (fields (field (name "Nota") "Bulk. Sostiene el bajon de arranque, medido 10,76 V"))
      (libsource (lib "Device") (part "CP") (description "Bulk 12 V"))))

  (nets
    (net (code "1") (name "GND")
      (node (ref "J1") (pin "4"))
      (node (ref "J1") (pin "5"))
      (node (ref "J2") (pin "1"))
      (node (ref "J2") (pin "7"))
      (node (ref "J3") (pin "2"))
      (node (ref "J3") (pin "4"))
      (node (ref "U1") (pin "5"))
      (node (ref "D1") (pin "2"))
      (node (ref "C1") (pin "2"))
      (node (ref "C2") (pin "2"))
      (node (ref "R3") (pin "2")))

    (net (code "2") (name "VBAT_RAW")
      (node (ref "J1") (pin "16"))
      (node (ref "F1") (pin "1")))

    (net (code "3") (name "VBAT_FUSED")
      (node (ref "F1") (pin "2"))
      (node (ref "D1") (pin "1"))
      (node (ref "C2") (pin "1"))
      (node (ref "U1") (pin "7"))
      (node (ref "J3") (pin "1"))
      (node (ref "R1") (pin "2"))
      (node (ref "R2") (pin "1")))

    (net (code "4") (name "K_LINE")
      (node (ref "J1") (pin "7"))
      (node (ref "J1") (pin "15"))
      (node (ref "U1") (pin "6"))
      (node (ref "R1") (pin "1")))

    (net (code "5") (name "+5V")
      (node (ref "J3") (pin "3"))
      (node (ref "J2") (pin "2")))

    (net (code "6") (name "+3V3")
      (node (ref "J2") (pin "4"))
      (node (ref "U1") (pin "3"))
      (node (ref "C1") (pin "1")))

    (net (code "7") (name "K_TX")
      (node (ref "U1") (pin "4"))
      (node (ref "J2") (pin "5")))

    (net (code "8") (name "K_RX")
      (node (ref "U1") (pin "1"))
      (node (ref "J2") (pin "3")))

    (net (code "9") (name "V_SENSE")
      (node (ref "R2") (pin "2"))
      (node (ref "R3") (pin "1"))
      (node (ref "J2") (pin "6")))

    (net (code "10") (name "NC_LO")
      (node (ref "U1") (pin "2")))

    (net (code "11") (name "NC_LI")
      (node (ref "U1") (pin "8")))))
